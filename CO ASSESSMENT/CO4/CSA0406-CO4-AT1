#include <stdio.h>
#include <stdlib.h>
int ab(int x) { return x < 0 ? -x : x; }
int main() {
    int disk[100]={0}, req[100], n, f, head, m, s, i, j;
    int cur, seek, count, best=9999, bestm, bests;
    printf("Disk blocks: ");
    scanf("%d",&n);
    printf("File size: ");
    scanf("%d",&f);
    printf("Number of requests: ");
    scanf("%d",&s);
    printf("Request queue: ");
    for(i=0;i<s;i++) scanf("%d",&req[i]);
    printf("Initial head: ");
    scanf("%d",&head);
    printf("Allocation (1=Contiguous, 2=Indexed): ");
    scanf("%d",&m);
    if(m==1) {
        for(i=0;i<=n-f;i++) {
            for(j=i;j<i+f && !disk[j];j++);
            if(j==i+f) break;
        }
        if(i>n-f) {
            printf("Contiguous allocation failed\n");
            return 0;
        }
        for(j=i;j<i+f;j++) disk[j]=1;
    }
    else {
        count=0;
        for(i=0;i<n && count<f;i++)
            if(!disk[i]) disk[i]=1,count++;
        if(count<f) {
            printf("Indexed allocation failed\n");
            return 0;
        }
    }
    printf("\nAllocated blocks: ");
    for(i=0;i<n;i++)
        if(disk[i]) printf("%d ",i);
    cur=head; seek=0;
    printf("\n\nFCFS: %d ",cur);
    for(i=0;i<s;i++) {
        if(!disk[req[i]]) continue;
        seek+=ab(cur-req[i]);
        cur=req[i];
        printf("->%d ",cur);
    }
    printf("\nSeek Time = %d",seek);
    if(seek<best) best=seek,bestm=m,bests=1;
    int done[100]={0}, min, pos;
    cur=head; seek=0;
    printf("\n\nSSTF: %d ",cur);
    for(count=0;count<s;count++) {
        min=9999; pos=-1;
        for(i=0;i<s;i++)
            if(!done[i] && disk[req[i]] &&
               ab(cur-req[i])<min)
                min=ab(cur-req[i]),pos=i;
        if(pos==-1) break;
        done[pos]=1;
        seek+=min;
        cur=req[pos];
        printf("->%d ",cur);
    }
    printf("\nSeek Time = %d",seek);
    if(seek<best) best=seek,bests=2;

    printf("\n\nBest Combination: %s + %s",
           bestm==1?"Contiguous":"Indexed",
           bests==1?"FCFS":"SSTF");
    printf("\nMinimum Seek Time = %d\n",best);
    return 0;
}
