#include <stdio.h>

int main() {
    int n,i,time=0,remain;
    int bt[10],rt[10],pr[10],wt[10]={0},tat[10];
    int min,index;

    printf("Enter number of processes: ");
    scanf("%d",&n);

    remain=n;

    for(i=0;i<n;i++) {
        printf("Burst Time and Priority: ");
        scanf("%d%d",&bt[i],&pr[i]);
        rt[i]=bt[i];
    }

    while(remain>0) {
        min=9999;
        index=-1;

        for(i=0;i<n;i++) {
            if(rt[i]>0 && pr[i]<min) {
                min=pr[i];
                index=i;
            }
        }

        rt[index]--;
        time++;

        if(rt[index]==0) {
            remain--;
            tat[index]=time;
            wt[index]=tat[index]-bt[index];
        }
    }

    printf("\nP\tWT\tTAT\n");
    for(i=0;i<n;i++)
        printf("P%d\t%d\t%d\n",i+1,wt[i],tat[i]);

    return 0;
}
