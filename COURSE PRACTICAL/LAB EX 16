#include <stdio.h>

int main()
{
    int block[5] = {100, 500, 200, 300, 600};
    int process[4] = {212, 417, 112, 426};
    int i, j, best, worst;

    printf("FIRST FIT\n");
    for(i = 0; i < 4; i++)
    {
        for(j = 0; j < 5; j++)
        {
            if(block[j] >= process[i])
            {
                printf("Process %d -> Block %d\n", i+1, j+1);
                block[j] -= process[i];
                break;
            }
        }
    }

    printf("\nBEST FIT\n");

    int b[5] = {100, 500, 200, 300, 600};

    for(i = 0; i < 4; i++)
    {
        best = -1;

        for(j = 0; j < 5; j++)
        {
            if(b[j] >= process[i])
            {
                if(best == -1 || b[j] < b[best])
                    best = j;
            }
        }

        if(best != -1)
        {
            printf("Process %d -> Block %d\n", i+1, best+1);
            b[best] -= process[i];
        }
    }

    printf("\nWORST FIT\n");

    int w[5] = {100, 500, 200, 300, 600};

    for(i = 0; i < 4; i++)
    {
        worst = -1;

        for(j = 0; j < 5; j++)
        {
            if(w[j] >= process[i])
            {
                if(worst == -1 || w[j] > w[worst])
                    worst = j;
            }
        }

        if(worst != -1)
        {
            printf("Process %d -> Block %d\n", i+1, worst+1);
            w[worst] -= process[i];
        }
    }

    return 0;
}
