#include <stdio.h>

int main()
{
    FILE *fp;
    char data[100];

    fp = fopen("file.txt", "w");
    printf("Enter data: ");
    scanf(" %[^\n]", data);
    fprintf(fp, "%s", data);
    fclose(fp);

    fp = fopen("file.txt", "r");
    fgets(data, 100, fp);
    printf("\nFile Data: %s\n", data);
    fclose(fp);

    remove("file.txt");
    printf("File deleted successfully\n");

    return 0;
}
