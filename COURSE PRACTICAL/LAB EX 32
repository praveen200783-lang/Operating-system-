#include <stdio.h>

int main()
{
    int block[20], next[20];
    int n, i, first, current;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("Enter next block (-1 for last):\n");
    for(i = 0; i < n; i++)
        scanf("%d", &next[i]);

    printf("Enter first block index: ");
    scanf("%d", &first);

    current = first;

    printf("\nLinked File Allocation:\n");

    while(current != -1)
    {
        printf("Block %d", block[current]);
        current = next[current];

        if(current != -1)
            printf(" -> ");
    }

    printf("\n");

    return 0;
}
