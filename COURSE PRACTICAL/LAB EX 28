#include <stdio.h>

int main()
{
    int pages[20], frame[3];
    int n, i, j, k, fault = 0;
    int found, pos, farthest, next;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page reference string:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    for(i = 0; i < 3; i++)
        frame[i] = -1;

    for(i = 0; i < n; i++)
    {
        found = 0;

        for(j = 0; j < 3; j++)
        {
            if(frame[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        if(found == 0)
        {
            fault++;
            pos = -1;
            farthest = -1;

            for(j = 0; j < 3; j++)
            {
                next = 0;

                for(k = i + 1; k < n; k++)
                {
                    if(frame[j] == pages[k])
                    {
                        next = k;
                        break;
                    }
                }

                if(next == 0)
                {
                    pos = j;
                    break;
                }

                if(next > farthest)
                {
                    farthest = next;
                    pos = j;
                }
            }

            frame[pos] = pages[i];
        }

        printf("\n%d : ", pages[i]);
        for(j = 0; j < 3; j++)
            printf("%d ", frame[j]);
    }

    printf("\n\nPage Faults = %d\n", fault);

    return 0;
}
