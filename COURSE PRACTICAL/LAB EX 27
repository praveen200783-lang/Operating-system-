#include <stdio.h>

int main()
{
    int pages[20], frame[3], recent[3];
    int n, i, j, k, fault = 0, found, pos;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page reference string:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    for(i = 0; i < 3; i++)
    {
        frame[i] = -1;
        recent[i] = 0;
    }

    for(i = 0; i < n; i++)
    {
        found = 0;

        for(j = 0; j < 3; j++)
        {
            if(frame[j] == pages[i])
            {
                found = 1;
                recent[j] = i;
                break;
            }
        }

        if(found == 0)
        {
            fault++;
            pos = 0;

            for(j = 1; j < 3; j++)
                if(recent[j] < recent[pos])
                    pos = j;

            frame[pos] = pages[i];
            recent[pos] = i;
        }

        printf("\n%d : ", pages[i]);
        for(k = 0; k < 3; k++)
            printf("%d ", frame[k]);
    }

    printf("\n\nPage Faults = %d\n", fault);

    return 0;
}
