#include <stdio.h>
#include <string.h>

int main()
{
    char files[20][20], name[20];
    int n = 0, i, found;

    printf("Enter number of files: ");
    scanf("%d", &n);

    printf("Enter file names:\n");
    for(i = 0; i < n; i++)
        scanf("%s", files[i]);

    printf("\nFiles in Single Level Directory:\n");
    for(i = 0; i < n; i++)
        printf("%s\n", files[i]);

    printf("\nEnter file to search: ");
    scanf("%s", name);

    found = 0;
    for(i = 0; i < n; i++)
    {
        if(strcmp(files[i], name) == 0)
        {
            found = 1;
            break;
        }
    }

    if(found)
        printf("File found\n");
    else
        printf("File not found\n");

    return 0;
}
